{
  "name": "polysocketserver",
  "version": "2.0.0",
  "private": true,
  "description": "B站与抖音直播弹幕采集和本地 WebSocket 转发",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx app.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch app.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:live": "tsx scripts/verify-live.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "axios": "^1.21.0",
    "mysql": "^2.18.1",
    "protobufjs": "^8.8.1",
    "puppeteer-core": "^25.16.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/mysql": "^2.15.28",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "repository": "git@github.com:LRolinx/PolySocketServer.git",
  "author": "LRolinx <yollx@qq.com>",
  "license": "MIT"
}
